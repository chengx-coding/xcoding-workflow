{
  "schema_version": 1,
  "name": "xcoding-workflow test plan",
  "description": "Single authority for test clusters, tiers, module membership and path selection. Read by xc_test_runner.py and xc_test_manifest_check.py; tests/support/tiers.py is the only implementation of the selection rules. See the private test-suite architecture design for rationale.",
  "test_root": "tests",
  "package_root": ".",
  "support_modules": [
    "tests.support.paths",
    "tests.support.cli",
    "tests.support.git",
    "tests.support.runtime",
    "tests.support.templates",
    "tests.support.tiers"
  ],
  "frozen_paths": [
    "tests/runtime_cli.py",
    "tests/viewer_cli.py",
    "tests/workflow_scenario_harness.py",
    "tests/test_xc_workflow_governance.py"
  ],
  "kernel_modules": [
    "test_xc_test_support",
    "test_xc_workflow_governance"
  ],
  "resources": [
    "runtime_cli.py",
    "viewer_cli.py",
    "workflow_scenario_harness.py"
  ],
  "worker_default": {
    "formula": "min(6, max(2, os.cpu_count() // 3))",
    "ceiling": 6,
    "floor": 2,
    "override": "--workers N",
    "measured_basis": "Full-tier wall clock measured on a 20-logical-core Windows machine after the in-process conversions, all runs ok=True with 909 executed tests and measured average concurrency equal to the worker count: 3 workers 743.7 s, 5 workers 641.8 s then 589.7 s, 6 workers 597.5 s. The repeated 5-worker measurements differ by 52 s, so this machine carries roughly +/-8% run-to-run variance and any single figure must be read with that band. The default formula resolves to 5 here. An earlier pre-conversion prototype measured 4 workers 603.4 s, 8 workers 618.5 s and 16 workers 712.9 s with one module failure from a 300 s subprocess timeout, so the ceiling stays well below the count where contention caused a failure."
  },
  "clusters": {
    "runtime": {
      "directory": "tests/runtime",
      "domain": "Orchestration runtime state machine: scheduling, transitions, integrity, persistence, subtree archival, restore points, control packets, silent outcome visibility, milestones, work-order mount, resume brief, governance stats, config contract drift",
      "modules": [
        "test_xc_orchestration_runtime",
        "test_xc_archive_subtree",
        "test_xc_restore_points",
        "test_xc_control_packet",
        "test_xc_silent_outcome_visibility",
        "test_xc_jit_milestone",
        "test_xc_work_order_mount",
        "test_xc_open_work_order",
        "test_xc_resume_brief",
        "test_xc_governance_stats",
        "test_config_contract_drift"
      ],
      "baseline_seconds": 384.8,
      "baseline_tests": 154,
      "coupled_clusters": [
        "governance"
      ]
    },
    "governance": {
      "directory": "tests/governance",
      "domain": "Governance classification, adaptive planning and enforcement, recovery planning, decision registry, fact cache, verification staleness, convention scanning, workshop setup, feature directory, lifecycle templates and disposition, new-feature report, orchestration author, runtime CLI parity and runtime query; plus the private-workshop citation guard",
      "modules": [
        "test_xc_adaptive_planning",
        "test_xc_adaptive_enforcement",
        "test_xc_adaptive_work_order",
        "test_xc_work_lifecycle_contract",
        "test_xc_lifecycle_disposition",
        "test_xc_recovery_plan",
        "test_xc_decision_registry",
        "test_xc_fact_cache",
        "test_xc_verification_staleness",
        "test_xc_convention_scanner",
        "test_xc_workshop_setup",
        "test_xc_feature",
        "test_xc_clarify",
        "test_xc_lifecycle_templates",
        "test_xc_new_feature_report",
        "test_xc_orchestration_author",
        "test_xc_runtime_cli_parity",
        "test_xc_runtime_query"
      ],
      "baseline_seconds": 366.5,
      "baseline_tests": 263,
      "notes": "test_xc_workflow_governance lives at the tests root because its path is a governance manifest input; it belongs to this cluster and is listed in kernel_modules instead of here to keep cluster membership unambiguous for path resolution."
    },
    "lifecycle": {
      "directory": "tests/lifecycle",
      "domain": "Full lifecycle end-to-end including feature adoption and new feature, gate recovery, report group ordering; document evolution end-to-end",
      "modules": [
        "test_xc_lifecycle_e2e",
        "test_xc_document_evolution_e2e"
