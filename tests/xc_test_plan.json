  "coupled_modules": {
    "test_xc_runtime_security": {
      "cluster": "delegation",
      "coupled_clusters": [
        "runtime"
      ],
      "reason": "Exercises runtime lock semantics as well as delegation deny-by-default; a runtime-only change must also run the delegation cluster, which the src/xcoding/runtime prefix rule provides."
    },
    "test_xc_governance_stats": {
      "cluster": "runtime",
      "coupled_clusters": [
        "governance"
      ],
      "reason": "Reads workshop state produced by governance flows."
    },
    "test_xc_resume_brief": {
      "cluster": "runtime",
      "coupled_clusters": [
        "governance"
      ],
      "reason": "Reads workshop state produced by governance flows."
    },
    "test_xc_skill_mirror": {
      "cluster": "documents",
      "coupled_clusters": [
        "packaging"
      ],
      "reason": "Checks the generated skill mirror, which the packaging cluster installs."
    }
  },
  "tiers": {
    "gate": {
      "target_seconds": 60,
      "description": "Mandatory guards, cheap in-process logic checks and manifest integrity; run after every change.",
      "selection": [
        {
          "selector": "class",
          "value": "tests.test_xc_workflow_governance.PrivateWorkshopCitationGuardTests"
        },
        {
          "selector": "test",
          "value": [
            "tests.documents.test_lf_write_contract.ProductionWritesPinTheirLineEndings.test_no_production_text_write_relies_on_the_host_default",
            "tests.documents.test_lf_write_contract.ProductionWritesPinTheirLineEndings.test_the_scan_detects_a_translating_write"
          ]
        },
        {
          "selector": "manual",
          "value": [
            "tests.support.test_xc_test_support",
            "tests.documents.test_xc_frontmatter_yaml",
            "tests.packaging.test_xc_version_consistency",
            "tests.governance.test_xc_lifecycle_disposition",
            "tests.governance.test_xc_work_lifecycle_contract",
            "tests.governance.test_xc_runtime_query",
            "tests.packaging.test_xc_package_metadata",
            "tests.daemon.test_xc_daemon_protocol",
            "tests.delegation.test_xc_delegation_gateway"
          ]
        }
      ],
      "excludes_real_worktree": true,
      "notes": "A gate-tier test must not open a temporary git repository, a socket, a thread, a real clock wait, or operate on the real repository worktree (manifest checks M5 and M9)."
    },
    "focused": {
      "target_seconds": 240,
      "description": "Default local iteration command: gate plus the clusters affected by the changed paths plus the support-layer contract tests.",
      "selection": [
        {
          "selector": "union",
          "value": [
            "tier:gate",
            "changed-clusters",
            "cluster:kernel"
          ]
        }
      ]
    },
    "full": {
      "target_seconds": 600,
      "description": "Every cluster, run in parallel. Required before merge and in CI.",
      "selection": [
        {
          "selector": "all-clusters"
        }
      ]
    },
    "release": {
      "target_seconds": null,
      "description": "Full plus release-only tests: real-process, real-git, socket, real-clock and real-worktree checks, and the recorded governance measurement replay.",
      "selection": [
        {
          "selector": "union",
          "value": [
            "tier:full",
            "release-only"
          ]
        }
      ]
    }
  },
  "release_only": {
    "modules": [
      "test_xc_package_cli",
      "test_xc_daemon_lifecycle",
      "test_xc_viewer"
    ],
    "tests": [
