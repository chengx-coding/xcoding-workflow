      "modules": [
        "test_xc_delegation",
        "test_xc_delegation_gateway",
        "test_xc_delegation_cli",
        "test_xc_runtime_security"
      ],
      "baseline_seconds": 40.7,
      "baseline_tests": 53,
      "coupled_clusters": [
