{
  "schema_version": 1,
  "purpose": "stage-1-project-host-adapter-data",
  "canonical_agents": {
    "root": "agents-src/agents",
    "filename_suffix": ".md"
  },
  "exporter_check": {
    "argv": [
      "python",
      "agents-src/export_agents.py",
      "--check"
    ]
  },
  "exact_set_policy": {
    "derive_from_canonical_agent_stems": true,
    "require_tracked_regular_files": true,
    "reject_missing": true,
    "reject_changed": true,
    "reject_extra": true
  },
  "adapters": [
    {
      "adapter_id": "claude-code",
      "capability_statement": "skills/xc-delegation/assets/adapters/claude-code.json",
      "generated_root": "agents-src/claude-agents",
      "generated_filename_suffix": ".md",
      "bundle_root": "adapters/claude-code",
      "project_agents_root": ".claude/agents",
      "project_skills_root": ".claude/skills"
    },
    {
      "adapter_id": "codex",
      "capability_statement": "skills/xc-delegation/assets/adapters/codex.json",
      "generated_root": "agents-src/codex-agents",
      "generated_filename_suffix": ".toml",
      "bundle_root": "adapters/codex",
      "project_agents_root": ".codex/agents",
      "project_skills_root": ".agents/skills"
    },
    {
      "adapter_id": "opencode",
      "capability_statement": "skills/xc-delegation/assets/adapters/opencode.json",
      "generated_root": "agents-src/opencode-agents",
      "generated_filename_suffix": ".md",
      "bundle_root": "adapters/opencode",
      "project_agents_root": ".opencode/agents",
      "project_skills_root": ".agents/skills"
    },
    {
      "adapter_id": "trae",
      "capability_statement": "skills/xc-delegation/assets/adapters/trae.json",
      "generated_root": "agents-src/trae-agents",
      "generated_filename_suffix": ".md",
      "bundle_root": "adapters/trae",
      "project_agents_root": ".trae/agents",
      "project_skills_root": ".agents/skills"
    }
  ]
}
