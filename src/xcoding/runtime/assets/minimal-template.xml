  <blackboard>
    <var key="scope.confirmed">false</var>
    <var key="review.open_issues">false</var>
    <var key="review.source_ids">[]</var>
  </blackboard>
  <node executor="main" mode="sequence" role="root" template_id="root" title="Example Workflow" type="composite">
    <children>
      <node executor="subagent" role="research" template_id="investigation" title="Investigate context" type="task" metadata.completion.required_fields="[&quot;summary&quot;,&quot;validation&quot;]" metadata.completion.artifacts.min="1" metadata.completion.artifacts.max="1" metadata.completion.artifacts.path="literal:artifacts/investigation/analysis.md">
        <instructions>Inspect the current project information and write a concise report.</instructions>
        <deliverables>artifacts/investigation/analysis.md</deliverables>
        <acceptance>Report exists, cites source files, and distinguishes facts from assumptions.</acceptance>
      </node>
      <node executor="main" role="scope-confirmation" template_id="scope-gate" title="Confirm scope" type="gate" metadata.gate.outcomes="[&quot;approved&quot;,&quot;revision-required&quot;]" metadata.gate.decision_required="true" metadata.gate.outcome_key="scope.gate_outcome">
        <instructions>Ask the user to confirm the scope after investigation.</instructions>
        <deliverables>Set scope.confirmed=true in the blackboard.</deliverables>
        <acceptance>User has confirmed scope or supplied corrections.</acceptance>
      </node>
      <node executor="main" loop.break_when="review.open_issues == false" loop.continue_when="review.open_issues == true" loop.max_iterations="3" loop.on_limit="blocked" mode="sequence" role="quality-loop" template_id="review-loop" title="Review and rework" type="loop">
        <children>
          <node executor="subagent" role="review" template_id="review" title="Review output" type="task">
            <instructions>Review current artifacts and set review.open_issues true or false.</instructions>
            <deliverables>artifacts/review-loop/review-{iteration}.md</deliverables>
            <acceptance>Review findings are prioritized and include closure criteria.</acceptance>
          </node>
          <node depends_on_template="local:review" executor="subagent" role="rework" template_id="rework" title="Rework output" type="task" when="review.open_issues == true" when.policy="latched" metadata.control_packet.category.review-records.selectors="[&quot;bb:review.source_ids&quot;]" metadata.control_packet.category.review-records.min_sources="1" metadata.control_packet.category.review-records.artifact_min="1" metadata.control_packet.blackboard_keys="[&quot;review.open_issues&quot;]">
            <instructions>Address the current review findings.</instructions>
            <deliverables>artifacts/review-loop/rework-{iteration}.md</deliverables>
            <acceptance>Required findings are fixed or explicitly deferred.</acceptance>
          </node>
        </children>
      </node>
    </children>
