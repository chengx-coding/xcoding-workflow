{
  "name": "feature-reconciliation",
  "schema_version": 1,
  "blackboard": {
    "reconciliation.feature_id": "",
    "reconciliation.needs_baseline_sync": "false",
    "reconciliation.has_ambiguous_conflict": "false",
    "reconciliation.provenance_source_ids": "[]",
    "reconciliation.conflict_source_ids": "[]",
    "reconciliation.conflict_outcome": "not-required"
  },
  "root": {
    "template_id": "root",
    "title": "Feature Reconciliation",
    "type": "composite",
    "role": "root",
    "mode": "sequence",
    "executor": "main",
    "children": [
      {
        "template_id": "load-feature-provenance",
        "title": "Load feature provenance",
        "type": "task",
        "role": "reconciliation-provenance",
        "executor": "subagent",
        "metadata": {
          "completion": {
            "required_fields": "[\"summary\",\"validation\"]",
            "artifacts": {
              "min": "1",
              "max": "1"
            }
          }
        },
        "instructions": "Read the feature baseline frontmatter and query referenced runtime trees only through xc-orchestration-runtime. Record provenance and current baseline references in the declared artifact.",
        "deliverables": "A provenance artifact for reconciliation.feature_id.",
        "acceptance": "The artifact identifies feature document provenance without directly reading runtime XML."
      },
      {
        "template_id": "inspect-current-state",
        "title": "Inspect current implementation state",
        "type": "task",
        "role": "reconciliation-inspection",
        "executor": "subagent",
        "metadata": {
          "control_packet": {
            "category": {
              "feature-provenance": {
                "selectors": "[\"bb:reconciliation.provenance_source_ids\"]",
                "min_sources": "1",
                "artifact_min": "1"
              }
            },
            "blackboard_keys": "[\"reconciliation.feature_id\"]"
          },
          "completion": {
            "required_fields": "[\"summary\",\"validation\"]",
            "artifacts": {
              "min": "1",
              "max": "1"
            }
          }
        },
        "instructions": "Compare code, executable tests, Git evidence, and feature baselines. Distinguish current implementation facts, approved target intent, evidence-backed drift, and ambiguous conflicts.",
        "deliverables": "A current-state artifact with evidence and a proposed reconciliation disposition.",
        "acceptance": "Every proposed difference is traceable and marked as synchronizable, conflicting, or unresolved."
      },
      {
        "template_id": "analysis-document",
        "title": "Update reconciliation analysis",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main"
      },
      {
        "template_id": "baseline-sync",
        "title": "Synchronize evidence-backed baseline drift",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main",
        "when": "reconciliation.needs_baseline_sync == true"
      },
      {
        "template_id": "conflict-gate",
        "title": "Resolve reconciliation conflict",
        "type": "gate",
        "role": "reconciliation-conflict",
        "executor": "main",
        "when": "reconciliation.has_ambiguous_conflict == true",
        "metadata": {
          "control_packet": {
            "category": {
              "supporting-records": {
                "selectors": "[\"bb:reconciliation.conflict_source_ids\"]",
                "min_sources": "3",
                "artifact_min": "3"
              }
            },
            "blackboard_keys": "[\"reconciliation.feature_id\"]"
          },
          "completion": {
            "required_fields": "[\"summary\",\"validation\"]"
          },
          "gate": {
            "outcomes": "[\"code-authoritative\",\"baseline-authoritative\",\"revise-goal\"]",
            "decision_required": "true",
            "outcome_key": "reconciliation.conflict_outcome"
          }
        },
        "instructions": "Present the code evidence, target baseline, requested work order goal, and proposed options. Record the user decision and add required document-evolution nodes.",
        "deliverables": "A structured user decision or an explicit blocked condition.",
        "acceptance": "No ambiguous product-intent conflict proceeds without a recorded decision."
      },
      {
        "template_id": "conflict-continuation",
        "title": "Route reconciliation decision",
        "type": "composite",
        "role": "gate-continuation",
        "mode": "switch",
        "executor": "main",
        "switch.key": "reconciliation.conflict_outcome",
        "switch.no_match": "blocked",
        "children": [
          {
            "template_id": "no-conflict-case",
            "title": "Continue without conflict",
            "type": "composite",
            "role": "case",
            "mode": "sequence",
            "executor": "main",
            "case.value": "not-required",
            "children": [
              {
                "template_id": "no-conflict-continuation",
                "title": "No conflict recovery required",
                "type": "composite",
                "role": "dynamic-group",
                "mode": "sequence",
                "executor": "main",
                "dynamic.state": "closed"
              }
            ]
          },
          {
            "template_id": "code-authoritative-case",
            "title": "Continue with code authority",
            "type": "composite",
            "role": "case",
            "mode": "sequence",
            "executor": "main",
            "case.value": "code-authoritative",
            "children": [
              {
                "template_id": "code-authoritative-continuation",
                "title": "Code-authoritative recovery complete",
                "type": "composite",
                "role": "dynamic-group",
                "mode": "sequence",
                "executor": "main",
                "dynamic.state": "closed"
              }
            ]
          },
          {
            "template_id": "baseline-authoritative-case",
            "title": "Continue with baseline authority",
            "type": "composite",
            "role": "case",
            "mode": "sequence",
            "executor": "main",
            "case.value": "baseline-authoritative",
            "children": [
              {
                "template_id": "baseline-authoritative-continuation",
                "title": "Baseline-authoritative recovery complete",
                "type": "composite",
                "role": "dynamic-group",
                "mode": "sequence",
                "executor": "main",
                "dynamic.state": "closed"
              }
            ]
          },
          {
            "template_id": "revise-goal-case",
            "title": "Recover revised work order goal",
            "type": "composite",
            "role": "case",
            "mode": "sequence",
            "executor": "main",
            "case.value": "revise-goal",
            "children": [
              {
                "template_id": "conflict-recovery-group",
                "title": "Revise goal and resolve reconciliation conflict",
                "type": "composite",
                "role": "dynamic-group",
                "mode": "sequence",
                "executor": "main"
              }
            ]
          }
        ]
      },
      {
        "template_id": "finalize-reconciliation",
        "title": "Finalize feature reconciliation",
        "type": "task",
        "role": "reconciliation-finalize",
        "executor": "main",
        "instructions": "Record the reconciliation disposition, synchronized baseline references, conflicts, and residual evidence gaps.",
        "deliverables": "A concise reconciliation result for the enclosing ordinary work order.",
        "acceptance": "The enclosing work order can select a solution without silently assuming code and baseline agreement."
      }
    ]
  }
}
