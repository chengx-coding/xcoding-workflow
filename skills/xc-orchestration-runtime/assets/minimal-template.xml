  <blackboard>
    <var key="scope.confirmed">false</var>
    <var key="review.open_issues">false</var>
  </blackboard>
  <node type="composite" template_id="root" role="root" mode="sequence" title="Example Workflow" executor="main">
    <children>
      <node type="task" template_id="investigation" role="research" title="Investigate context" executor="subagent">
        <instructions>Inspect the current project context and write a concise report.</instructions>
        <deliverables>artifacts/investigation/analysis.md</deliverables>
        <acceptance>Report exists, cites source files, and distinguishes facts from assumptions.</acceptance>
      </node>
      <node type="gate" template_id="scope-gate" role="scope-confirmation" title="Confirm scope" executor="main">
        <instructions>Ask the user to confirm the scope after investigation.</instructions>
        <deliverables>Set scope.confirmed=true in the blackboard.</deliverables>
        <acceptance>User has confirmed scope or supplied corrections.</acceptance>
      </node>
      <node loop.break_when="review.open_issues == false" type="loop" loop.on_limit="blocked" template_id="review-loop" role="quality-loop" mode="sequence" title="Review and rework" loop.max_iterations="3" executor="main" loop.continue_when="review.open_issues == true">
        <children>
          <node type="task" template_id="review" role="review" title="Review output" executor="subagent">
            <instructions>Review current artifacts and set review.open_issues true or false.</instructions>
            <deliverables>artifacts/review-loop/review-{iteration}.md</deliverables>
            <acceptance>Review findings are prioritized and include closure criteria.</acceptance>
          </node>
          <node type="task" depends_on_template="local:review" when="review.open_issues == true" template_id="rework" role="rework" title="Rework output" executor="subagent">
            <instructions>Address the current review findings.</instructions>
            <deliverables>artifacts/review-loop/rework-{iteration}.md</deliverables>
            <acceptance>Required findings are fixed or explicitly deferred.</acceptance>
          </node>
        </children>
      </node>
    </children>
  </node>
</orchestration>
