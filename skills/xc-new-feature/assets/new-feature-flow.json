{
  "name": "new-feature",
  "schema_version": 1,
  "blackboard": {
    "feature.id": "",
    "feature.title": "",
    "feature.approval_required": "true",
    "work_order.document_language": "en",
    "work_order.requires_clarification": "false",
    "work_order.requires_implementation": "true",
    "work_order.requires_verification": "true"
  },
  "root": {
    "template_id": "root",
    "title": "New Feature",
    "type": "composite",
    "role": "root",
    "mode": "sequence",
    "executor": "main",
    "children": [
      {
        "template_id": "prepare-feature",
        "title": "Prepare new feature",
        "type": "task",
        "role": "feature-prepare",
        "executor": "main",
        "instructions": "Read the project bridge, open the work order through xc-open-work-order, determine and validate work_order.document_language through xc-document from the explicit parameter or initiating user request, select an explicit feature ID, and create its empty directory through xc-feature.",
        "deliverables": "An authoritative workbench and empty managed feature directory.",
        "acceptance": "The workshop Git worktree is independent, the feature ID is explicit, work_order.document_language is set before any document write, and no baseline document exists outside document evolution."
      },
      {
        "template_id": "goal-document",
        "title": "Define work order goal",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main"
      },
      {
        "template_id": "analysis-group",
        "title": "Analyze feature evidence",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main"
      },
      {
        "template_id": "clarification-group",
        "title": "Clarify material decisions",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main",
        "when": "work_order.requires_clarification == true"
      },
      {
        "template_id": "work-order-solution-document",
        "title": "Select work order solution",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main"
      },
      {
        "template_id": "feature-contract-document",
        "title": "Establish feature contract",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main"
      },
      {
        "template_id": "feature-solution-document",
        "title": "Establish feature solution",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main"
      },
      {
        "template_id": "feature-verification-document",
        "title": "Establish feature verification",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main"
      },
      {
        "template_id": "approve-feature-baseline",
        "title": "Approve feature baseline",
        "type": "gate",
        "role": "feature-approval",
        "executor": "main",
        "when": "feature.approval_required == true",
        "instructions": "Present the accepted contract, feature solution, verification baseline, and work order solution. Record approval or requested revision through the runtime.",
        "deliverables": "A recorded approval decision or follow-up document-evolution nodes.",
        "acceptance": "The feature baseline is approved or the tree contains explicit revision and review work."
      },
      {
        "template_id": "implementation-group",
        "title": "Implement feature",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main",
        "when": "work_order.requires_implementation == true"
      },
      {
        "template_id": "verification-group",
        "title": "Verify feature",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main",
        "when": "work_order.requires_verification == true"
      },
      {
        "template_id": "result-document",
        "title": "Record feature result",
        "type": "composite",
        "role": "dynamic-group",
        "mode": "sequence",
        "executor": "main"
      },
      {
        "template_id": "finalize-feature",
        "title": "Finalize new feature work order",
        "type": "task",
        "role": "feature-finalize",
        "executor": "main",
        "instructions": "Confirm the result, feature baseline provenance, declared artifacts, and validation evidence, then close the work order.",
        "deliverables": "A completed, failed, or blocked work order with durable result evidence.",
        "acceptance": "The runtime tree and declared workbench artifacts accurately represent the outcome."
      }
    ]
  }
}
